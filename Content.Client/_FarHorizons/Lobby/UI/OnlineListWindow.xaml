<DefaultWindow
    xmlns="https://spacestation14.io"
    SetSize="320 400"> <!-- Starlight, split list up into staff/patron/player -->
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5">
            <Label Text="{Loc 'online-list-window-staff'}" StyleClasses="LabelHeading"/>
            <RichTextLabel Name="StaffList" Margin="5 0 0 8"/>

            <Label Text="{Loc 'online-list-window-patrons'}" StyleClasses="LabelHeading"/>
            <RichTextLabel Name="PatronList" Margin="5 0 0 8"/>

            <Label Text="{Loc 'online-list-window-players'}" StyleClasses="LabelHeading"/>
            <RichTextLabel Name="PlayerList" Margin="5 0 0 0"/>
        </BoxContainer>
    </ScrollContainer>
</DefaultWindow>
